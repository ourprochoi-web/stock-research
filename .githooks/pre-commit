#!/usr/bin/env python3
"""스테이징된 .html 의 JSON-LD dateModified 를 커밋일로 맞춘다.

CLAUDE.md §H 가 허용한 예외(동기화 훅) 중 하나. 이것이 없으면 dateModified 는
곧바로 다시 드리프트한다(2026-08-08 일괄 교정 시점 기준 91/114 편이 어긋나 있었다).

두 가지를 일부러 건너뛴다.

- dateModified 줄만 바뀐 커밋. 그것까지 오늘로 찍으면 "날짜를 고쳤으니
  갱신일이 오늘" 이라는 순환이 되고, 6월에 쓰고 손대지 않은 글이 오늘
  갱신된 것처럼 보인다. dateModified 는 내용이 바뀐 날이어야 한다.
- 부분 스테이징된 파일. 워킹트리를 고쳐 re-add 하면 스테이징하지 않은
  변경까지 커밋에 끌려들어온다.
"""
import re
import json
import subprocess
import sys
from datetime import date

PAT = re.compile(r'("dateModified"\s*:\s*")([^"]*)(")')
TIMELINE = re.compile(r"▸\s*20\d\d[.\-]\d\d[.\-]\d\d")
LOG = "update_log.html"
INDEX = "index.html"
SITEMAP = "sitemap.xml"
BASE = "https://ourprochoi-web.github.io/stock-research/"

# sitemap 미등록 경고에서 제외한다.
# 기준은 "빠뜨린 것"과 "안 올린 것"의 구분이다 — §F2 는 새 페이지를 등재하라는
# 규칙이지 모든 HTML 을 검색에 노출하라는 규칙이 아니다.
# portfolio_tracker.html 은 읽히려고 만든 글이 아니라 실계좌 수량·평단을 담은
# 조회용 화면이고(§J1 의 첫 단계가 이 데이터를 본다), sitemap 의 목적인
# "검색 노출"과 용도가 다르다. 파일은 이미 배포돼 있으므로 접근이 막히는 것도
# 아니고, 등재만 하지 않는다.
# 여기에 추가할 때는 같은 기준을 통과해야 한다 — "읽는 사람이 아니라 내가 보는
# 화면인가". 편의로 늘리면 §F2 가 무력해진다.
SITEMAP_EXEMPT = {
    "portfolio/portfolio_tracker.html",
    # 2026-08-18 추가. 같은 기준을 통과한다 — "읽는 사람이 아니라 내가 보는 화면인가".
    # 판정 대기판은 41개 페이지에 흩어진 판정 조건 중 날짜/이벤트가 특정된 것만
    # 모은 운영 화면이다. 검색 노출이 목적이 아니라 "무엇이 언제 판정되는가"를
    # 한 화면에서 보려고 만들었고, 내용은 전부 각 페이지의 반증 조건에서 온다.
    # (섹터 지도 board/sector_map.html 은 반대다 — 읽히려고 만든 입구이므로
    #  sitemap 에 등재한다.)
    "board/judgment_board.html",
    # 2026-08-25 추가. 같은 기준을 통과한다 — "읽는 사람이 아니라 내가 보는 화면인가".
    # 추적 계기판은 data/prices.json 하나만 읽어 §J8 수급 문턱·§J13 환율금리·
    # 임박 판정 이벤트·창별 극단을 계산해 띄우는 운영 화면이다. 새 데이터를
    # 만들지 않고 이미 수집 중인 것을 렌더링만 한다(§H).
    "portfolio/tracking_dashboard.html",
}


def run(*args):
    return subprocess.run(args, capture_output=True, text=True).stdout


def content_changed(path):
    """dateModified 줄 말고 다른 것도 바뀌었는가."""
    diff = run("git", "diff", "--cached", "-U0", "--", path).splitlines()
    body = [ln for ln in diff
            if ln[:1] in "+-" and not ln.startswith(("+++", "---"))]
    if not body:  # 신규 추가 등, 판단 불가하면 찍는다
        return True
    return any("dateModified" not in ln for ln in body)


def added_timeline_entries(path):
    """이번 커밋에서 footer 타임라인 '▸ 날짜' 항목이 새로 붙었는가."""
    diff = run("git", "diff", "--cached", "-U0", "--", path).splitlines()
    return [ln[1:].strip() for ln in diff
            if ln.startswith("+") and not ln.startswith("+++")
            and TIMELINE.search(ln)]


def sync_index_updated(pages):
    """index.html DATA 의 updated 를 각 페이지의 실제 dateModified 로 맞춘다.

    date 는 건드리지 않는다 — 시리즈 카드가 date 오름차순으로 정렬되므로
    바꾸면 Part 순서가 깨진다. updated 는 '최근 업데이트' 목록 전용이다.

    지시로는 실패한다는 것이 실측으로 확인됐다: 2026-08-09 시점에
    DATA 의 date 가 실제 dateModified 와 113편 중 80편이 어긋나 있었다.
    새 저장소를 만들지 않고 기존 index.html 안에서만 동기화한다.
    """
    try:
        with open(INDEX, encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        return []

    changed = []
    for page in pages:
        if page == INDEX:
            continue
        try:
            with open(page, encoding="utf-8") as fh:
                real = PAT.search(fh.read())
        except OSError:
            continue
        if not real:
            continue
        real = real.group(2)[:10]

        entry = re.compile(
            r'(      file: "' + re.escape(page) + r'",\n'
            r'      date: "(\d{4}-\d{2}-\d{2})",)'
            r'(\n      updated: "\d{4}-\d{2}-\d{2}",)?'
        )
        m = entry.search(text)
        if not m:
            continue
        want = "" if real == m.group(2) else f'\n      updated: "{real}",'
        if (m.group(3) or "") == want:
            continue
        text = text[:m.start()] + m.group(1) + want + text[m.end():]
        changed.append(page)

    if changed:
        with open(INDEX, "w", encoding="utf-8") as fh:
            fh.write(text)
        subprocess.run(["git", "add", INDEX], check=True)
    return changed


def sync_sitemap_lastmod(pages):
    """sitemap.xml 의 lastmod 를 각 페이지의 실제 dateModified 로 맞춘다.

    §H 가 허용한 다섯 번째 예외. index DATA updated 와 같은 종류이고 같은
    이유다 — §F3 이 "페이지 + DATA + sitemap + update_log 를 한 커밋으로"
    라고 지시하는데, 2026-08-11 측정 결과 113편 중 84편이 어긋나 있었다.
    훅이 강제하는 셋(dateModified · index updated · update_log)은 전부 0이고
    강제되지 않는 sitemap 만 74% 가 무너졌다. 지시로는 실패한다.

    새 저장소를 만들지 않고 기존 sitemap.xml 안에서만 동기화한다.
    dateModified 가 없는 페이지(index.html 등)는 건드리지 않는다 —
    비교할 기준이 없으면 맞출 것도 없다.

    반환: (동기화된 페이지, sitemap 에 항목이 없는 페이지)
    """
    try:
        with open(SITEMAP, encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        return [], []

    changed, missing = [], []
    for page in pages:
        try:
            with open(page, encoding="utf-8") as fh:
                real = PAT.search(fh.read())
        except OSError:
            continue
        if not real:  # JSON-LD 가 없는 페이지는 대상이 아니다
            continue
        real = real.group(2)[:10]

        entry = re.compile(
            r"(<loc>" + re.escape(BASE + page) + r"</loc>\s*<lastmod>)"
            r"(\d{4}-\d{2}-\d{2})"
            r"(</lastmod>)"
        )
        m = entry.search(text)
        if not m:
            if page not in SITEMAP_EXEMPT:
                missing.append(page)
            continue
        if m.group(2) == real:
            continue
        text = text[:m.start(2)] + real + text[m.end(2):]
        changed.append(page)

    if changed:
        with open(SITEMAP, "w", encoding="utf-8") as fh:
            fh.write(text)
        subprocess.run(["git", "add", SITEMAP], check=True)
    return changed, missing


def check_update_log(staged):
    """§F3 — 페이지에 날짜 항목을 남겼으면 update_log.html 도 같이 커밋한다.

    지시만으로는 Tier 1 커밋 6개에서 6/6 누락됐다. 죽는 층은 언제나
    '다른 파일에 한 번 더 써야 하는 층'이라, 여기서는 막는 쪽을 택한다.
    훅이 내용을 쓰지는 않는다 — 무엇이 왜 바뀌었는지는 판단이 필요하다.
    """
    if LOG in staged:
        return 0
    flagged = [(f, added_timeline_entries(f)) for f in staged if f != LOG]
    flagged = [(f, e) for f, e in flagged if e]
    if not flagged:
        return 0

    print(f"\n[pre-commit] 막힘 — {LOG} 이 함께 스테이징되지 않았습니다.\n")
    print("  아래 페이지에 날짜 항목이 새로 붙었습니다:")
    for f, entries in flagged:
        print(f"    · {f}")
        for e in entries[:2]:
            print(f"        {e[:96]}")
    print(f"\n  CLAUDE.md §F3: 페이지 수정 + DATA + sitemap + {LOG} 를 한 커밋으로.")
    print(f"  {LOG} 에 같은 내용을 남기고 `git add {LOG}` 후 다시 커밋하세요.")
    print("  이 커밋에 로그가 필요 없다면 `git commit --no-verify`.\n")
    return 1


def main():
    today = date.today().isoformat()
    staged = [f for f in run("git", "diff", "--cached", "--name-only",
                             "--diff-filter=ACM").splitlines()
              if f.endswith(".html")]
    # 2026-09-14 수정 — HTML 없이 brain/theses.json 만 스테이징된 커밋(라우팅으로 basis 만 갱신)에서
    # 여기서 종료돼 카드 렌더(아래)에 닿지 못했다. 첫 실전(미즈호 라우팅)에서 카드가 낡은 채 커밋됐다.
    # 「카드가 브레인에서 나온다」가 성립하려면 브레인만 바뀐 커밋도 렌더까지 가야 한다.
    _cached = run("git", "diff", "--cached", "--name-only").splitlines()
    brain_staged = any(f in _cached for f in ("brain/theses.json", "brain/regime.json", "brain/portfolio.json",
                                              "brain/mechanisms.json", "brain/routing.jsonl", "brain/events.json"))
    if not staged and not brain_staged:
        return 0

    # v3 브레인 검사(2026-09-15 · 경고만) — regime·mechanisms·portfolio JSON 유효성 · 엣지 theses 포인터 · prediction 형식 · 레짐 신선도
    if brain_staged:
        try:
            import json as _j
            _T = _j.load(open("brain/theses.json", encoding="utf-8"))["pages"]
            for _f in ("brain/regime.json", "brain/mechanisms.json", "brain/portfolio.json"):
                _j.load(open(_f, encoding="utf-8"))
            _M = _j.load(open("brain/mechanisms.json", encoding="utf-8"))
            _bad = []
            for _ed in _M["edges"]:
                for _t in _ed.get("theses", []):
                    if "#" in _t and not _t.startswith("events:"):
                        _pg, _id = _t.split("#", 1)
                        if _pg not in _T or _id not in {x["id"] for x in _T[_pg]["theses"]}:
                            _bad.append((_ed["id"], _t))
                if _ed["from"] not in _M["nodes"] or _ed["to"] not in _M["nodes"]:
                    _bad.append((_ed["id"], "node 없음"))
            if _bad:
                print(f"[pre-commit] ⚠ mechanisms 포인터 {len(_bad)}건 실재 안 함 — {_bad[:3]}")
            _R = _j.load(open("brain/regime.json", encoding="utf-8"))
            from datetime import date as _d
            _age = (_d.today() - _d.fromisoformat(_R["asof"])).days
            if _age > 7:
                print(f"[pre-commit] 🟠 regime.json 신선도 {_age}일 — 주 1회 「같은 레짐인가」를 history 에 답한다")
            _np = 0
            for _ln in open("brain/routing.jsonl", encoding="utf-8"):
                if _ln.strip():
                    _r = _j.loads(_ln)
                    if _r.get("kind") == "prediction" and not _r.get("resolve_by"):
                        _np += 1
            if _np:
                print(f"[pre-commit] ⚠ prediction 에 resolve_by 없음 {_np}건")
            print("[pre-commit] [brain v3] ✓ regime·mechanisms·portfolio 유효" + ("" if _bad else " · 포인터 실재"))
        except Exception as _e:  # noqa: BLE001
            print(f"[pre-commit] ⚠ brain v3 검사 실패 — 커밋은 진행: {_e}")

    # 계약 검사(2026-09-26 · AGENTS.md §3) — routing·theses·events·intake 가 스테이징되면 새 routing 줄의 스키마·포인터·테제 접촉을 검사한다.
    # 유일하게 <차단>하는 브레인 검사다. 경고 열흘의 결과가 「테제에 닿은 routing 30% · Lead 봇 줄 33건 전부 digest-only」였다.
    _contract_files = {"brain/routing.jsonl", "brain/theses.json", "brain/events.json",
                       "intake/user.jsonl", "intake/collected.jsonl"}
    if _contract_files & set(_cached):
        r = subprocess.run([sys.executable, ".githooks/check_routing.py"], capture_output=True, text=True)
        for ln in r.stdout.splitlines():
            print("[pre-commit] " + ln)
        if r.returncode != 0:
            print("\n[pre-commit] 막힘 — routing 계약 위반(AGENTS.md §3). 고친 뒤 다시 커밋. 정말 예외면 --no-verify 를 쓰고 그 이유를 커밋 메시지에 적는다.\n")
            return 1

    if staged and check_update_log(staged):
        return 1

    # 인덱스와 워킹트리가 다른 파일 = 부분 스테이징. 제외한다.
    partial = set(run("git", "diff", "--name-only").splitlines())

    touched, skipped, dateonly = [], [], 0
    for f in staged:
        if f in partial:
            skipped.append(f)
            continue
        if not content_changed(f):
            dateonly += 1
            continue
        try:
            with open(f, encoding="utf-8") as fh:
                text = fh.read()
        except OSError:
            continue
        m = PAT.search(text)
        if not m or m.group(2)[:10] == today:
            continue
        with open(f, "w", encoding="utf-8") as fh:
            fh.write(text[:m.start(2)] + today + text[m.end(2):])
        subprocess.run(["git", "add", f], check=True)
        touched.append(f)

    # index.html 이 부분 스테이징이면 건드리지 않는다(위 partial 과 같은 이유).
    if INDEX not in partial:
        synced = sync_index_updated([f for f in staged if f not in partial])
        if synced:
            print(f"[pre-commit] index DATA updated 동기화 {len(synced)}편")
    elif INDEX in staged:
        print(f"[pre-commit] {INDEX} 부분 스테이징이라 updated 동기화 건너뜀")

    # sitemap.xml 도 부분 스테이징이면 건드리지 않는다(위와 같은 이유).
    if SITEMAP not in set(run("git", "diff", "--name-only").splitlines()):
        synced, missing = sync_sitemap_lastmod(
            [f for f in staged if f not in partial and f != INDEX])
        if synced:
            print(f"[pre-commit] sitemap lastmod 동기화 {len(synced)}편")
        if missing:
            print(f"[pre-commit] ⚠ sitemap 에 항목이 없습니다 ({len(missing)}편) "
                  "— §F2: 등록 안 하면 만들지 않은 것입니다")
            for f in missing[:3]:
                print(f"    · {f}")
    else:
        print(f"[pre-commit] {SITEMAP} 부분 스테이징이라 lastmod 동기화 건너뜀")

    # 테제 색인 재생성 — §H 여섯 번째 예외(2026-09-13). 87편에 흩어진 「현재 판단」을
    # docs/thesis_index.md 한 파일로 <파생>한다. 사람이 유지하지 않으므로 죽지 않고,
    # 새 데이터를 만들지 않는다(정본은 페이지). 실패해도 커밋은 막지 않는다.
    if any(f != INDEX and f != LOG and "/" in f for f in staged):
        try:
            r = subprocess.run([sys.executable, ".githooks/build_thesis_index.py"],
                               capture_output=True, text=True, check=True)
            if run("git", "diff", "--name-only", "--", "docs/thesis_index.md").strip() \
               or run("git", "ls-files", "--others", "--", "docs/thesis_index.md").strip():
                subprocess.run(["git", "add", "docs/thesis_index.md"], check=True)
                print(r.stdout.strip())
        except (subprocess.CalledProcessError, OSError) as e:
            print(f"[pre-commit] ⚠ thesis_index 재생성 실패 — 커밋은 진행: {e}")

    # 이름 색인 재생성 — 2026-09-17 구조 개선 B. brain 이나 추적 목록이 바뀌면 docs/name_index.md · .json 을 다시 만든다(생성물).
    if brain_staged or any(f.endswith("update_prices.py") for f in staged):
        try:
            r = subprocess.run([sys.executable, ".githooks/build_name_index.py"], capture_output=True, text=True, check=True)
            print("[pre-commit] " + r.stdout.strip())
            for f in ("docs/name_index.md", "docs/name_index.json"):
                subprocess.run(["git", "add", f], check=True)
        except (subprocess.CalledProcessError, OSError) as e:
            print(f"[pre-commit] ⚠ name_index 재생성 실패 — 커밋은 진행: {e}")

    # 브레인 카드 렌더 — brain/theses.json 이나 카드 페이지가 스테이징되면 카드를 다시 찍어 함께 커밋한다(2026-09-13).
    # 페이지 상단 「현재 판단」의 정본은 theses.json 이고 카드는 생성물이다. 사람이 카드를 고쳐도 여기서 덮인다.
    if brain_staged or staged:
        try:
            r = subprocess.run([sys.executable, ".githooks/render_cards.py", *staged],
                               capture_output=True, text=True)
            for ln in r.stdout.splitlines():
                print("[pre-commit] " + ln)
                m = re.search(r"카드 렌더 — (\S+)", ln)
                if m and m.group(1) not in partial:
                    subprocess.run(["git", "add", m.group(1)], check=True)
        except OSError as e:
            print(f"[pre-commit] ⚠ 카드 렌더 실패 — 커밋은 진행: {e}")

    # 브레인 구멍 검사 — 스테이징된 페이지의 <b>T?.</b> 집합이 brain/theses.json 에 다 있는지(경고만 · 2026-09-14).
    # 실측: 시드 직후 43/407 테제가 빠져 있었고, 09-14 라우팅 4건 중 4건이 구멍에 걸렸다. 원인은 추출기의
    # 12K 캡·「반증 조건」 본문 문구 충돌(둘 다 build_thesis_index.py 에서 수정). 이 검사는 재발을 잡는다.
    try:
        _doc = json.load(open("brain/theses.json", encoding="utf-8")).get("pages", {})
        for _p in staged:
            if _p not in _doc:
                continue
            _ids = set(re.findall(r"<b>(T\d)\.", open(_p, encoding="utf-8", errors="ignore").read()))
            _br = {t.get("id") for t in _doc[_p].get("theses", [])}
            _miss = sorted(_ids - _br)
            if _miss:
                print(f"[pre-commit] ⚠ 브레인 구멍 — {_p} 페이지 테제 {_miss} 가 brain/theses.json 에 없다")
    except Exception as _e:
        print(f"[pre-commit] ⚠ 브레인 구멍 검사 실패 — 커밋은 진행: {_e}")

    # 수치 층 검사 — brain/facts.json 의 값이 정본 페이지에 있는지(경고만 · 2026-09-13).
    # 페이지를 고쳤는데 facts 를 안 고쳤거나 그 반대를 잡는다. 새 저장소가 아니라
    # 이미 페이지에 있는 값의 정본을 한 파일로 모은 것이며, 이 검사가 §B5 「정본 1곳」을 강제한다.
    all_staged = run("git", "diff", "--cached", "--name-only", "--diff-filter=ACMR").splitlines()
    if "brain/facts.json" in all_staged or staged:
        try:
            args = [] if "brain/facts.json" in all_staged else staged
            r = subprocess.run([sys.executable, ".githooks/check_facts.py", *args],
                               capture_output=True, text=True)
            out = r.stdout.strip()
            if out and ("⚠" in out or "brain/facts.json" in all_staged):
                print(out)
        except OSError as e:
            print(f"[pre-commit] ⚠ facts 검사 실패 — 커밋은 진행: {e}")

    # 세 층 포인터 검사 — routing·facts 의 intake id, theses 의 facts 키가 실재하는지(경고만 · 2026-09-13).
    layer_files = {"brain/routing.jsonl", "brain/facts.json", "brain/theses.json", "intake/user.jsonl", "intake/collected.jsonl"}
    if layer_files & set(all_staged):
        try:
            r = subprocess.run([sys.executable, ".githooks/check_intake.py"], capture_output=True, text=True)
            if r.stdout.strip():
                print("[pre-commit] " + r.stdout.strip().replace("\n", "\n[pre-commit] "))
        except OSError as e:
            print(f"[pre-commit] ⚠ 포인터 검사 실패 — 커밋은 진행: {e}")

    if touched:
        print(f"[pre-commit] dateModified → {today} ({len(touched)}편)")
    if dateonly:
        print(f"[pre-commit] 날짜 줄만 바뀌어 유지 {dateonly}편")
    if skipped:
        print(f"[pre-commit] 부분 스테이징이라 건너뜀 {len(skipped)}편: "
              + ", ".join(skipped[:3]) + ("..." if len(skipped) > 3 else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
